# Environnement du lab, écrit en clair : toute modification repasse par `direnv allow`.
# Nécessite direnv. Sans direnv, voir la cible env du Makefile.
PATH_add "$HOME/Dev/aklaos-outils/bin"
export KIND_EXPERIMENTAL_PROVIDER=docker
export KUBECONFIG="$PWD/.kube/config"
export HELM_CACHE_HOME="$PWD/.local/helm/cache"
export HELM_CONFIG_HOME="$PWD/.local/helm/config"
export HELM_DATA_HOME="$PWD/.local/helm/data"
